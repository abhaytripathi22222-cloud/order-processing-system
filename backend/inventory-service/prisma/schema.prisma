generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Inventory {
  id        Int      @id @default(autoincrement())
  sku       String   @unique
  quantity  Int
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id          Int      @id @default(autoincrement())
  orderId     Int
  orderNumber String
  sku         String
  quantity    Int
  status      String
  createdAt   DateTime @default(now())
}