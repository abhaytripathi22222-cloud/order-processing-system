generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {

  id Int @id @default(autoincrement())

  orderNumber String @unique

  customerId String

  sku String

  quantity Int

  status String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}