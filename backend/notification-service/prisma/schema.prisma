generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Notification {
  id          Int      @id @default(autoincrement())
  orderNumber String
  type        String
  recipient   String
  status      String
  createdAt   DateTime @default(now())
}
model ProcessedEvent {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())
}