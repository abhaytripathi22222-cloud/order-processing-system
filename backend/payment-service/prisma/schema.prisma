generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Payment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  orderNumber String
  amount      Float
  status      String
  transactionId String?
  createdAt   DateTime @default(now())
}